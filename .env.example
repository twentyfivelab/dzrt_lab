# ─────────────────────────────────────────────────────────────
#  Variables d'environnement — dzrt
#  Copiez ce fichier en « .env.local » et renseignez vos valeurs.
# ─────────────────────────────────────────────────────────────

# URL publique du site (sans slash final) — utilisée pour le SEO,
# les balises canoniques, l'Open Graph, le sitemap, etc.
NEXT_PUBLIC_SITE_URL=https://www.dzrt.fr

# ── Resend (envoi des emails du formulaire de contact) ──
# Créez une clé sur https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse expéditrice (doit appartenir à un domaine vérifié sur Resend).
# Exemple : "dzrt <contact@dzrt.fr>"
CONTACT_FROM_EMAIL=dzrt <contact@dzrt.fr>

# Adresse qui reçoit les demandes envoyées via le formulaire.
CONTACT_TO_EMAIL=hello@dzrt.fr
